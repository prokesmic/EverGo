// --- Training Plans Models ---

model TrainingPlan {
  id              String    @id @default(cuid())

  // Plan details
  name            String
  description     String
  duration        Int       // Total weeks
  level           String    // Enum: BEGINNER, INTERMEDIATE, ADVANCED

  // Sport association
  sportId         String

  // Settings
  isTemplate      Boolean   @default(true)  // Pre-built template vs custom
  isPublic        Boolean   @default(true)
  creatorId       String?   // null for system templates

  // Metadata
  imageUrl        String?
  tags            String    // JSON array: ["marathon", "5K", "beginner"]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  weeks           TrainingPlanWeek[]
  userPlans       UserTrainingPlan[]

  @@index([sportId, level])
  @@index([isPublic])
}

model TrainingPlanWeek {
  id              String    @id @default(cuid())
  planId          String
  plan            TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  weekNumber      Int       // 1-indexed
  title           String?   // e.g., "Base Building"
  description     String?

  workouts        TrainingPlanWorkout[]

  @@unique([planId, weekNumber])
  @@index([planId])
}

model TrainingPlanWorkout {
  id              String    @id @default(cuid())
  weekId          String
  week            TrainingPlanWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  dayOfWeek       Int       // 0 = Monday, 6 = Sunday
  title           String    // e.g., "Easy Run"
  description     String?   // e.g., "Run at comfortable pace"

  // Target metrics
  targetType      String    // Enum: DISTANCE, DURATION, REST
  targetValue     Float?    // km or minutes
  targetUnit      String?   // "km", "min"

  // Additional guidance
  intensity       String?   // Enum: EASY, MODERATE, HARD, RACE_PACE
  notes           String?   // JSON: { warmup: "10min", cooldown: "5min", intervals: [...] }

  @@index([weekId])
}

model UserTrainingPlan {
  id              String    @id @default(cuid())
  userId          String
  planId          String
  plan            TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // Progress
  startDate       DateTime
  currentWeek     Int       @default(1)
  status          String    @default("ACTIVE") // Enum: ACTIVE, PAUSED, COMPLETED, ABANDONED

  // Completion tracking (JSON)
  completedWorkouts String  @default("[]") // [{weekNumber, dayOfWeek, activityId, completedAt}]

  completedAt     DateTime?
  pausedAt        DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, planId])
  @@index([userId])
}

// --- Benchmark / Personal Best (PB) Models ---

enum BenchmarkMeasurementType {
  TIME            // seconds; lower is better
  DISTANCE        // meters/km; higher better
  SPEED           // km/h; higher better
  POWER           // watts; higher better
  WEIGHT_REPS     // kg + reps; used to compute est 1RM, higher better
  SCORE           // points, rating; higher better
  COUNT           // reps, waves, matches; higher better
  GRADE_LEVEL     // ordinal ladder (climbing grade, trick level); higher better
  RESULT          // win/loss/draw or placing; mapped to score points
}

enum BenchmarkSource {
  MANUAL
  ACTIVITY_DERIVED
  IMPORT_STRAVA
  IMPORT_GARMIN
  IMPORT_APPLE_HEALTH
  IMPORT_GOOGLE_FIT
  SENSOR_WOO          // Woo Kite sensor
  SENSOR_SURFR        // Surfr sensor
  SENSOR_OTHER        // Other sport-specific sensors
  DEVICE_OTHER        // Generic device import
}

enum BenchmarkVerificationStatus {
  UNVERIFIED
  VERIFIED_LINKED_ACTIVITY
  VERIFIED_IMPORT
}

enum ActivityResultSource {
  AUTO
  USER_CONFIRMED
  USER_ENTERED
}

model BenchmarkDefinition {
  id              String   @id @default(cuid())
  sportId         String
  slug            String   // unique per sport (e.g. "5k", "bench-1rm")
  name            String   // display: "5K", "Bench Press 1RM", "Max Jump"
  measurementType BenchmarkMeasurementType
  unit            String   // "sec", "km", "m", "kg", "w", "points", "level"
  higherIsBetter  Boolean  @default(true)

  // JSON target specification:
  // TIME/DISTANCE benchmarks may include {distanceMeters: 5000} or {durationSec: 1200}
  targetJson      Json?

  // Validity window (months) for ranking impact
  validityMonths  Int      @default(24)
  // Soft decay threshold (months)
  decayAfterMonths Int     @default(12)

  // Relative importance for Sport Index seeding
  rankWeight      Float    @default(1.0)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sport           Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  userBests       UserBenchmarkBest[]
  activityResults ActivityBenchmarkResult[]

  @@unique([sportId, slug])
  @@index([sportId, isActive])
}

model UserBenchmarkBest {
  id                 String   @id @default(cuid())
  userId             String
  benchmarkId        String

  // Store numeric canonical value:
  // TIME => seconds; DISTANCE => meters; SPEED => kmh; POWER => watts; SCORE/COUNT/LEVEL => numeric
  value              Float
  achievedAt         DateTime
  source             BenchmarkSource @default(MANUAL)
  verificationStatus BenchmarkVerificationStatus @default(UNVERIFIED)
  evidenceUrl        String?

  // Convenience flags
  isLegacy           Boolean  @default(false) // computed at write-time (older than validity window)

  // v4.2: Auditability & traceability
  externalActivityId String?  // Link to source activity (internal or external ID)
  metadata           Json?    // Extra context: { race_name, conditions, elevation, etc. }
  isEligibleGlobal   Boolean  @default(true)  // Computed: passes minTierGlobal check
  isEligibleCountry  Boolean  @default(true)  // Computed: passes minTierCountry check
  isEligibleCity     Boolean  @default(true)  // Computed: passes minTierCity check
  isEligibleTeam     Boolean  @default(true)  // Computed: passes minTierTeam check

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  benchmark          BenchmarkDefinition @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@unique([userId, benchmarkId]) // latest/active PB per benchmark
  @@index([userId])
  @@index([benchmarkId])
  @@index([isEligibleGlobal, benchmarkId])  // For efficient global leaderboard queries
}

model ActivityBenchmarkResult {
  id               String   @id @default(cuid())
  activityId       String
  benchmarkId      String

  value            Float
  source           ActivityResultSource @default(AUTO)

  isPersonalBest   Boolean  @default(false)
  countsForRanking Boolean  @default(true)

  computedAt       DateTime @default(now())

  activity         Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  benchmark        BenchmarkDefinition @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@unique([activityId, benchmarkId])
  @@index([benchmarkId])
}

// --- Strava Integration Models ---

model StravaConnection {
