// =============================================================================
// v4.2: BACKFILL STATE (Checkpointing for backfill jobs)
// =============================================================================

enum BackfillJobType {
  PERSONAL_BESTS     // Backfill PersonalBests from activities
  ELIGIBILITY_FLAGS  // Recompute isEligible* flags
  RANKING_CACHE      // Rebuild ranking caches
  SPORT_INDEX        // Recalculate sport indices
}

enum BackfillStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

model BackfillState {
  id            String         @id @default(cuid())
  jobType       BackfillJobType
  status        BackfillStatus @default(PENDING)

  // Checkpoint cursor (JSON for flexibility)
  cursor        Json?          // { userId: "...", lastActivityId: "...", page: 5 }

  // Progress tracking
  totalItems    Int?           // Total items to process (if known)
  processedItems Int           @default(0)
  skippedItems  Int            @default(0)
  errorItems    Int            @default(0)

  // Timing
  startedAt     DateTime?
  pausedAt      DateTime?
  completedAt   DateTime?
  lastHeartbeat DateTime?      // For detecting stalled jobs

  // Error tracking
  lastError     String?
  errorLog      Json?          // Array of errors for debugging

  // Configuration
  batchSize     Int            @default(100)
  configJson    Json?          // Job-specific configuration

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([jobType])  // Only one active job per type
  @@index([status, jobType])
}

// --- Rivalry Models ---

// =============================================================================
// SPORT INDEX EVENTS (Explainability / Audit Trail)
// =============================================================================

enum SportIndexEventType {
  ACTIVITY_ADDED
  ACTIVITY_EDITED
  ACTIVITY_DELETED
  ACTIVITY_IMPORTED
  PERSONAL_BEST_ADDED
  PERSONAL_BEST_UPDATED
  RIVALRY_SCORE_CHANGED
  RIVALRY_COMPLETED
  DECAY_APPLIED
  VERIFICATION_UPGRADED
  ANOMALY_FLAGGED
  ADMIN_ADJUSTMENT
}

enum VerificationTier {
  BRONZE  // manual no proof
  SILVER  // manual with proof (photo/gpx) OR trusted device w/o gps
  GOLD    // device sync w/ gps (Strava/Garmin/Health)
}

enum EntityType {
  ACTIVITY
  PERSONAL_BEST
  COMPETITION
}

model SportIndexSnapshot {
  id        String   @id @default(cuid())
  userId    String
  sportSlug String
  value     Int
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sportSlug])
  @@index([sportSlug, value])
}

model SportIndexEvent {
  id            String              @id @default(cuid())
  createdAt     DateTime            @default(now())

  userId        String
  sportSlug     String
  type          SportIndexEventType

  // the "before/after" so users can understand deltas
  prevValue     Int?
  newValue      Int?
  deltaValue    Int?

  // rank movement (optional; populate when you compute rankings)
  prevRankCity    Int?
  newRankCity     Int?
  prevRankCountry Int?
  newRankCountry  Int?
  prevRankGlobal  Int?
  newRankGlobal   Int?

  // what caused it
  entityType    EntityType?
  entityId      String?

  // short message + structured details for UI
  title         String
  detailJson    Json?

  // traceability
  requestId     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, sportSlug, createdAt])
  @@index([entityType, entityId])
}

// =============================================================================
// ANTI-CHEAT (Anomaly Detection + Disputes)
// =============================================================================

enum AnomalyType {
  IMPOSSIBLE_PACE
  IMPOSSIBLE_SPEED
  IMPOSSIBLE_DISTANCE
  GPS_JUMP
  TOO_MANY_MICRO_ACTIVITIES
}

model ActivityAnomaly {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  activityId String
  userId     String
  type       AnomalyType
  severity   Int         // 1-5
  message    String
  detailJson Json?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([userId, createdAt])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_ACCEPTED
  RESOLVED_REJECTED
}

model Dispute {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reporterUserId String
  againstUserId  String?

  competitionId  String?
  activityId     String?

  reason       String
  detailJson   Json?
  status       DisputeStatus @default(OPEN)

  reporter User @relation("DisputeReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@index([activityId])
  @@index([status, createdAt])
}

// =============================================================================
// UNIFIED COMPETITION ENGINE
// =============================================================================

enum CompetitionType {
  RIVALRY
  CHALLENGE
  TEAM_BATTLE
}

enum CompetitionStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum ScoringMode {
  VOLUME
  BENCHMARK
  STREAK
}

enum ScoringMetric {
  DISTANCE
  DURATION
  SESSIONS
  TIME
  REPS
  SCORE
  ELEVATION_GAIN
}

enum ParticipantEntityType {
  USER
  TEAM
}

enum CompetitionEventType {
  SCORE_CHANGED
  COMPLETED
  DISPUTED
  ACCEPTED
}

model Competition {
  id              String            @id @default(cuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  type            CompetitionType
  status          CompetitionStatus @default(PENDING)
  visibility      RivalryVisibility @default(FRIENDS)

  sportSlug       String?
  sportSubtype    String?

  windowStart     DateTime
  windowEnd       DateTime

  scoringMode     ScoringMode
  scoringMetric   ScoringMetric
  benchmarkId     String?           // if BENCHMARK mode

  createdByUserId String
  createdByUser   User              @relation("CompetitionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  participants    CompetitionParticipant[]
  snapshots       CompetitionSnapshot[]
  events          CompetitionEvent[]

  leaderEntityId  String?           // winner userId or teamId depending on competition
  lastComputedAt  DateTime?

  disputeId       String?           // link to Dispute if status=DISPUTED

  @@index([createdByUserId])
  @@index([status, windowEnd])
  @@index([type, status])
}

model CompetitionParticipant {
  id              String                @id @default(cuid())
  competitionId   String

  entityType      ParticipantEntityType
  entityId        String                // userId or teamId

  joinedAt        DateTime?
  acceptedAt      DateTime?
  isAccepted      Boolean               @default(false)

  // rolling computed fields
  scoreValue      Float?
  bestValue       Float?
  bestActivityId  String?
  lastActivityAt  DateTime?

  competition     Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@unique([competitionId, entityType, entityId])
}

model CompetitionSnapshot {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  competitionId String

  // normalized payload to render scoreboards and explain changes
  snapshotJson  Json

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, createdAt])
}

model CompetitionEvent {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  competitionId String
  type          CompetitionEventType
  title         String
  detailJson    Json?

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, createdAt])
}

// =============================================================================
// RIVALRY MODELS (keeping existing, will migrate to Competition engine)
// =============================================================================

enum RivalryStatus {
  PENDING
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum RivalryMode {
  VOLUME
  BENCHMARK
}

enum RivalryMetric {
  DISTANCE    // sum of distance in meters
  DURATION    // sum of duration in seconds
  SESSIONS    // count of activities
  TIME        // benchmark: fastest time (lower is better)
  REPS        // benchmark: max reps (higher is better)
  SCORE       // benchmark: highest score (higher is better)
}

enum RivalryVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

model Rivalry {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  status          RivalryStatus    @default(PENDING)
  visibility      RivalryVisibility @default(FRIENDS)

  // Sport association
  sportSlug       String
  sportSubtype    String?          // optional discipline

  // Competition rules
  mode            RivalryMode
  metric          RivalryMetric
  benchmarkId     String?          // if mode=BENCHMARK, link to BenchmarkDefinition

  // Time window
  windowStart     DateTime
  windowEnd       DateTime
  inviteExpiresAt DateTime

  // Creator
  createdByUserId String
  createdByUser   User             @relation("RivalryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  // Participants
  participants    RivalryParticipant[]

  // Computed snapshot for fast UI
  leaderUserId    String?
  lastComputedAt  DateTime?

  @@index([createdByUserId])
  @@index([status, windowEnd])
  @@index([sportSlug, status])
}

model RivalryParticipant {
  id             String    @id @default(cuid())
  rivalryId      String
  rivalry        Rivalry   @relation(fields: [rivalryId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Acceptance status
  isCreator      Boolean   @default(false)
  isAccepted     Boolean   @default(false)
  acceptedAt     DateTime?
  joinedAt       DateTime?

  // Computed scores (updated on activity log)
  scoreValue     Float?    // total distance/duration/sessions for VOLUME mode
  bestValue      Float?    // best benchmark value for BENCHMARK mode
  bestActivityId String?   // activity that achieved the best benchmark
  lastActivityAt DateTime?
  activityCount  Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([rivalryId, userId])
  @@index([userId, rivalryId])
}

model UserSportRating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportSlug String

  // Elo-like rating
  rating    Int      @default(1000)
  rd        Int?     // rating deviation (optional for Glicko-2)

  // Stats
  wins      Int      @default(0)
  losses    Int      @default(0)
  ties      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sportSlug])
  @@index([sportSlug, rating(sort: Desc)])
}

model RivalryResult {
  id            String   @id @default(cuid())
  rivalryId     String   @unique

  // Winner determination
  winnerUserId  String?  // null if tie
  loserUserId   String?  // null if tie
  isTie         Boolean  @default(false)

  // Final scores
  winnerScore   Float?
  loserScore    Float?

  // Rating changes
  winnerRatingDelta Int?
  loserRatingDelta  Int?

  completedAt   DateTime @default(now())

  @@index([winnerUserId])
  @@index([loserUserId])
}

// --- Most Active / Universal Activity Score ---

model UserActivityScore {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Snapshot date (start of day UTC)
  asOfDate      DateTime

  // Rolling window configuration
  windowDays    Int      @default(28) // 28-day rolling window

  // Computed values
  totalEffort   Int      // Sum of effortPoints in window
  activityScore Int      // Scaled 0-1000 for leaderboard
  activityCount Int      @default(0) // Number of activities in window

  // Location for regional rankings (denormalized from User)
  country       String?
  city          String?

  createdAt     DateTime @default(now())

  @@unique([userId, asOfDate, windowDays])
  @@index([asOfDate, windowDays, activityScore(sort: Desc)])
  @@index([asOfDate, windowDays, country, activityScore(sort: Desc)])
  @@index([asOfDate, windowDays, city, activityScore(sort: Desc)])
}

// =============================================================================
// DISCIPLINE-BASED LEADERBOARD CACHE
// =============================================================================

model DisciplineLeaderboardCache {
  id              String    @id @default(cuid())
  disciplineId    String
  discipline      Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  // Scope definition
  scope           String    // GLOBAL, COUNTRY, CITY, TEAM
  scopeValue      String?   // null for global, "Czech Republic" for country, etc.

  // Ranked Disciplines v4: Verification filter
  verifiedOnly    Boolean   @default(false)

  // Cached leaderboard data (top 100)
  leaderboard     String    // JSON: [{userId, rank, value, formattedValue, delta, name, avatar, source?, isVerified?}]
  totalUsers      Int

  calculatedAt    DateTime  @default(now())

  @@unique([disciplineId, scope, scopeValue, verifiedOnly])
  @@index([disciplineId, verifiedOnly])
}

// =============================================================================
// FEED ITEMS (Highlights Feed)
// =============================================================================

enum FeedItemType {
  PERSONAL_BEST
  RANK_DELTA
  RIVALRY_SWING
  RIVALRY_COMPLETED
  TEAM_WIN
  NOTABLE_ACTIVITY
  NEW_FOLLOW
  BADGE_EARNED
  STREAK_MILESTONE
}

model FeedItem {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())

  type            FeedItemType
  actorUserId     String       // User who triggered the event
  subjectUserId   String?      // Target user (for follows, rivalries)

  // Related entities
  activityId      String?
  disciplineId    String?
  discipline      Discipline?  @relation(fields: [disciplineId], references: [id])
  rivalryId       String?
  competitionId   String?
  badgeId         String?

  // Delta/value for rankings
  deltaRank       Int?
  deltaValue      Float?
  newValue        Float?
  formattedValue  String?

  // Display
  title           String
  subtitle        String?
  imageUrl        String?

  // Visibility
  visibility      String       @default("PUBLIC") // PUBLIC, FOLLOWERS, PRIVATE

  // Engagement
  likesCount      Int          @default(0)
  commentsCount   Int          @default(0)

  // Computed highlight score (for feed ordering)
  highlightScore  Int          @default(0)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

// =============================================================================
// INVITE CODES (Alpha Gating)
// =============================================================================

model InviteCode {
  id              String    @id @default(cuid())
  code            String    @unique

  // Creator
  createdByUserId String?

  // Usage limits
  maxUses         Int       @default(1)
  usedCount       Int       @default(0)

  // Validity
  expiresAt       DateTime?
  isActive        Boolean   @default(true)

  // Tracking
  usages          InviteCodeUsage[]

  createdAt       DateTime  @default(now())

  @@index([code])
  @@index([isActive, expiresAt])
}

model InviteCodeUsage {
  id              String     @id @default(cuid())
  inviteCodeId    String
  inviteCode      InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

  usedByUserId    String
  usedAt          DateTime   @default(now())

  @@unique([inviteCodeId, usedByUserId])
}

// =============================================================================
// ANALYTICS EVENTS (Simple tracking)
// =============================================================================

model AnalyticsEvent {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())

  // Event info
  eventName       String    // onboarding_complete, connect_strava, activity_created, etc.
  userId          String?
  sessionId       String?

  // Properties (JSON)
  properties      Json?

  // Context
  userAgent       String?
  ipCountry       String?

  @@index([eventName, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}
